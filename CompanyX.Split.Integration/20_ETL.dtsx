              SQLTask:Connection="{3B8653A6-4D79-41A5-8B6F-0DBB6C4B12C7}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'CompanyX_DW_ACT_20261107' OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'CompanyXSplitOwner' AND CONVERT(nvarchar(100),value)=N'companyx-split-20261107') OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE name='CompanyXDemoOwner' AND CONVERT(nvarchar(100),value)='CompanyX_Demo_20261103') THROW 51800,'Owned demo only',1;&#xA;IF SCHEMA_ID('ssis_flow') IS NULL EXEC('CREATE SCHEMA ssis_flow');&#xA;IF OBJECT_ID('ssis_flow.Context') IS NULL CREATE TABLE ssis_flow.Context(Id int PRIMARY KEY CHECK(Id=1),BatchId bigint NOT NULL,PreviousVersion bigint NULL,NextVersion bigint NULL);&#xA;IF OBJECT_ID('ssis_flow.Delta_BillOfMaterials') IS NULL SELECT TOP(0) NULLIF(R.[BillOfMaterialsID],R.[BillOfMaterialsID]) AS [BillOfMaterialsID],NULLIF(R.[ProductAssemblyID],R.[ProductAssemblyID]) AS [ProductAssemblyID],NULLIF(R.[ComponentID],R.[ComponentID]) AS [ComponentID],NULLIF(R.[StartDate],R.[StartDate]) AS [StartDate],NULLIF(R.[EndDate],R.[EndDate]) AS [EndDate],NULLIF(R.[UnitMeasureCode],R.[UnitMeasureCode]) AS [UnitMeasureCode],NULLIF(R.[BOMLevel],R.[BOMLevel]) AS [BOMLevel],NULLIF(R.[PerAssemblyQty],R.[PerAssemblyQty]) AS [PerAssemblyQty],NULLIF(R.[ModifiedDate],R.[ModifiedDate]) AS [ModifiedDate],CONVERT(nvarchar(1),NULL) FlowOperation,CONVERT(bigint,NULL) FlowVersion,CONVERT(bigint,NULL) FlowBatchId INTO ssis_flow.Delta_BillOfMaterials FROM etl_raw.[BillOfMaterials] R;&#xA;IF OBJECT_ID('ssis_flow.Delta_Location') IS NULL SELECT TOP(0) NULLIF(R.[LocationID],R.[LocationID]) AS [LocationID],NULLIF(R.[Name],R.[Name]) AS [Name],NULLIF(R.[CostRate],R.[CostRate]) AS [CostRate],NULLIF(R.[Availability],R.[Availability]) AS [Availability],NULLIF(R.[ModifiedDate],R.[ModifiedDate]) AS [ModifiedDate],CONVERT(nvarchar(1),NULL) FlowOperation,CONVERT(bigint,NULL) FlowVersion,CONVERT(bigint,NULL) FlowBatchId INTO ssis_flow.Delta_Location FROM etl_raw.[Location] R;&#xA;IF OBJECT_ID('ssis_flow.Delta_P