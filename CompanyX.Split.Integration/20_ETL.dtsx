                      SQLTask:SqlStatementSource="DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context);&#xA;&#xA;INSERT etl_v2.TargetChange(BatchID,TableName,Operation,KeyJson,BeforeJson,AfterJson) SELECT @B,N'dw.Fact_ProductVendorTerms','U',(SELECT D.[ProductKey],D.[VendorKey],D.[AsOfDateKey] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES),(SELECT D.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES),(SELECT P.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES) FROM dw.Fact_ProductVendorTerms D JOIN etl_calc.[Fact_ProductVendorTerms] P ON P.[ProductKey]=D.[ProductKey] AND P.[VendorKey]=D.[VendorKey] AND P.[AsOfDateKey]=D.[AsOfDateKey] WHERE EXISTS(SELECT P.[UnitMeasureKey],P.[AverageLeadTime],P.[StandardPrice],P.[LastReceiptCost],P.[LastReceiptDateKey],P.[MinOrderQty],P.[MaxOrderQty],P.[OnOrderQty],P.[IsOrderQtyRangeValid] EXCEPT SELECT D.[UnitMeasureKey],D.[AverageLeadTime],D.[StandardPrice],D.[LastReceiptCost],D.[LastReceiptDateKey],D.[MinOrderQty],D.[MaxOrderQty],D.[OnOrderQty],D.[IsOrderQtyRangeValid]);&#xA;UPDATE D SET D.[UnitMeasureKey]=P.[UnitMeasureKey],D.[AverageLeadTime]=P.[AverageLeadTime],D.[StandardPrice]=P.[StandardPrice],D.[LastReceiptCost]=P.[LastReceiptCost],D.[LastReceiptDateKey]=P.[LastReceiptDateKey],D.[MinOrderQty]=P.[MinOrderQty],D.[MaxOrderQty]=P.[MaxOrderQty],D.[OnOrderQty]=P.[OnOrderQty],D.[IsOrderQtyRangeValid]=P.[IsOrderQtyRangeValid],D.[LoadBatchID]=P.[LoadBatchID],D.[LoadedAt]=P.[LoadedAt] FROM dw.Fact_ProductVendorTerms D JOIN etl_calc.[Fact_ProductVendorTerms] P ON P.[ProductKey]=D.[ProductKey] AND P.[VendorKey]=D.[VendorKey] AND P.[AsOfDateKey]=D.[AsOfDateKey] WHERE EXISTS(SELECT P.[UnitMeasureKey],P.[AverageLeadTime],P.[StandardPrice],P.[LastReceiptCost],P.[LastReceiptDateKey],P.[MinOrderQty],P.[MaxOrderQty],P.[OnOrderQty],P.[IsOrderQtyRangeValid] EXCEPT SELECT D.[UnitMeasureKey],D.[AverageLeadTime],D.[StandardPrice],D.[LastReceiptCost],D.[LastReceiptDateKey],D.[MinOrderQty],D.[MaxOrderQty],D.[OnOrderQty]