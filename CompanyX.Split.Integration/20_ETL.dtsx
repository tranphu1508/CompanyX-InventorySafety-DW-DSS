                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context WITH(READUNCOMMITTED)); SELECT P.[ProductKey],P.[VendorKey],P.[AsOfDateKey],P.[UnitMeasureKey],P.[AverageLeadTime],P.[StandardPrice],P.[LastReceiptCost],P.[LastReceiptDateKey],P.[MinOrderQty],P.[MaxOrderQty],P.[OnOrderQty],P.[IsOrderQtyRangeValid],P.[LoadBatchID],P.[LoadedAt] FROM etl_calc.[Fact_ProductVendorTerms] P WITH(READUNCOMMITTED) WHERE NOT EXISTS(SELECT 1 FROM dw.Fact_ProductVendorTerms D WITH(READUNCOMMITTED) WHERE P.[ProductKey]=D.[ProductKey] AND P.[VendorKey]=D.[VendorKey] AND P.[AsOfDateKey]=D.[AsOfDateKey])</property>
