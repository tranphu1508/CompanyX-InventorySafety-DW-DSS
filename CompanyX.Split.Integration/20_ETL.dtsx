                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context WITH(READUNCOMMITTED)); SELECT P.[ProductKey],P.[PriceType],P.[StartDate],P.[EndDate],P.[Amount],P.[LoadBatchID],P.[LoadedAt] FROM etl_calc.[Ref_ProductPriceHistory] P WITH(READUNCOMMITTED) WHERE NOT EXISTS(SELECT 1 FROM dw.Ref_ProductPriceHistory D WITH(READUNCOMMITTED) WHERE P.[ProductKey]=D.[ProductKey] AND P.[PriceType]=D.[PriceType] AND P.[StartDate]=D.[StartDate])</property>
