        <DTS:Executable
          DTS:refId="Package\ETL - Mo tung nhom de xem Data Flow\02 Bat dau batch va transaction DW"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:DTSID="{72FB6FC7-EF56-476F-86D0-72278E972FC5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:FailParentOnFailure="True"
          DTS:LocaleID="-1"
          DTS:ObjectName="02 Bat dau batch va transaction DW"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3B8653A6-4D79-41A5-8B6F-0DBB6C4B12C7}"
              SQLTask:TimeOut="1800"
              SQLTask:SqlStatementSource=" SET NOCOUNT ON; SET XACT_ABORT ON;&#xA; DECLARE @Lock int,@B bigint=NULL,@Previous bigint,@Next bigint,@Changes bigint,@Targets bigint,@Summary nvarchar(max);&#xA; EXEC @Lock=sys.sp_getapplock @Resource=N'DSS_RESULT',@LockMode='Exclusive',@LockOwner='Session',@LockTimeout=0;&#xA; IF @Lock&lt;0 THROW 51901,'DW publication/ETL is busy; no changes made.',1;&#xA;&#xA;  EXEC @Lock=sys.sp_getapplock @Resource=N'InventorySafety_FullLoad',@LockMode='Exclusive',@LockOwner='Session',@LockTimeout=0;&#xA;  IF @Lock&lt;0 THROW 51902,'Another ETL load is busy.',1;&#xA;  IF EXISTS(SELECT 1 FROM etl.ETL_LoadBatch WHERE Status='RUNNING') THROW 51903,'A batch is already RUNNING; inspect it before loading.',1;&#xA;  SELECT @Previous=LastVersion FROM etl_v2.State WHERE Id=1;&#xA;  INSERT etl.ETL_LoadBatch(SourceSystem,PipelineName,ExtractionMode,LoadMode,ExtractStartedAt,RuleSetVersion,Status,ValidationStatus,SourceSnapshotReference)&#xA;   VALUES(N'CompanyX SQL Server',N'DWH_INCREMENTAL_V2',IIF(@Previous IS NULL,N'FULL',N'INCREMENTAL'),IIF(@Previous IS NULL,N'INITIAL_FULL',N'INCREMENTAL'),SYSUTCDATETIME(),N'S2T-V6;SAL-BACKFILL-v2;CT-v1',N'RUNNING',N'NOT_RUN',N'Change Tracking: atomic source version, retained raw deltas and row before-images');&#xA;  SET @B=SCOPE_IDENTITY();&#xA;  INSERT etl_v2.BatchState VALUES(@B,@Previous,NULL,SYSUTCDATETIME(),NULL,NULL,'RUNNING',NULL);&#xA;  SET TRANSACTION ISOLATION LEVEL READ COMMITTED; BEGIN TRAN;&#xA; DELETE ssis_flow.Context; INSERT ssis_flow.Context VALUES(1,@B,@Previous,NULL);&#xA;DELETE ssis_flow.Delta_BillOfMaterials;&#xA;DELETE ssis_flow.Delta_Location;&#xA;DELETE ssis_flow.Delta_Product;&#xA;DELETE ssis_flow.Delta_ProductCategory;&#xA;DELETE ssis_flow.Delta_ProductCostHistory;&#xA;DELETE ssis_flow.Delta_ProductInventory;&#xA;DELETE ssis_flow.Delta_ProductListPriceHistory;&#xA;DELETE ssis_flow.Delta_ProductSubcategory;&#xA;DELETE ssis_flow.Delta_ScrapReason;&#xA;DELETE ssis_flow.Delta_TransactionHistory;&#xA;DELETE ssis_flow.Delta_TransactionHistoryArchive;&#xA;DELETE ssis_flow.Delta_UnitMeasure;&#xA;DELETE ssis_flow.Delta_WorkOrder;&#xA;DELETE ssis_flow.Delta_WorkOrderRouting;&#xA;DELETE ssis_flow.Delta_ProductVendor;&#xA;DELETE ssis_flow.Delta_PurchaseOrderDetail;&#xA;DELETE ssis_flow.Delta_PurchaseOrderHeader;&#xA;DELETE ssis_flow.Delta_Vendor;&#xA;DELETE ssis_flow.Delta_Customer;&#xA;DELETE ssis_flow.Delta_SalesOrderDetail;&#xA;DELETE ssis_flow.Delta_SalesOrderHeader;&#xA;DELETE ssis_flow.Delta_SpecialOffer;&#xA;DELETE ssis_flow.Delta_SpecialOfferProduct;&#xA;SELECT @B BatchId,COALESCE(@Previous,-1) PreviousVersion;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::BatchId" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="1"
                SQLTask:DtsVariableName="User::PreviousVersion" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
