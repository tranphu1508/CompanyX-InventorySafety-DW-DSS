    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AF4EA793-99AD-4C9A-8233-ABCD1FE07183}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;DECLARE @Previous bigint=&quot; + (DT_WSTR,30)@[User::PreviousVersion] + &quot;,@Next bigint=&quot; + (DT_WSTR,30)@[User::NextVersion] + &quot;; DECLARE @CTPrevious bigint=CASE WHEN @Previous&lt;0 THEN 0 ELSE @Previous END; SELECT S.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],CONVERT(nvarchar(1),N'I') FlowOperation,CONVERT(bigint,@Next) FlowVersion FROM [Production].[BillOfMaterials] S WHERE @Previous&lt;0 UNION ALL SELECT C.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],CONVERT(nvarchar(1),C.SYS_CHANGE_OPERATION) FlowOperation,C.SYS_CHANGE_VERSION FlowVersion FROM CHANGETABLE(CHANGES [Production].[BillOfMaterials],@CTPrevious) C LEFT JOIN [Production].[BillOfMaterials] S ON S.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE @Previous&gt;=0 AND C.SYS_CHANGE_VERSION&lt;=@Next;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Query_1">
      <DTS:VariableValue
        DTS:DataType="8">DECLARE @Previous bigint=-1,@Next bigint=0; DECLARE @CTPrevious bigint=CASE WHEN @Previous&lt;0 THEN 0 ELSE @Previous END; SELECT S.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],CONVERT(nvarchar(1),N'I') FlowOperation,CONVERT(bigint,@Next) FlowVersion FROM [Production].[BillOfMaterials] S WHERE @Previous&lt;0 UNION ALL SELECT C.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],CONVERT(nvarchar(1),C.SYS_CHANGE_OPERATION) FlowOperation,C.SYS_CHANGE_VERSION FlowVersion FROM CHANGETABLE(CHANGES [Production].[BillOfMaterials],@CTPrevious) C LEFT JOIN [Production].[BillOfMaterials] S ON S.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE @Previous&gt;=0 AND C.SYS_CHANGE_VERSION&lt;=@Next;</DTS:VariableValue>
    </DTS:Variable>
