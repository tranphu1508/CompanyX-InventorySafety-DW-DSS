                  SQLTask:TimeOut="1800"
                  SQLTask:SqlStatementSource="DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context); EXEC etl_v2.Validate @B;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
