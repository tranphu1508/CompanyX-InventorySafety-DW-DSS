                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context WITH(READUNCOMMITTED)); SELECT P.[BillOfMaterialsID],P.[AssemblyProductKey],P.[ComponentProductKey],P.[UnitMeasureKey],P.[BOMLevel],P.[PerAssemblyQty],P.[StartDate],P.[EndDate],P.[IsStructureValid],P.[DQReasonCode],P.[DQRuleVersion],P.[LoadBatchID],P.[LoadedAt] FROM etl_calc.[Bridge_BillOfMaterials] P WITH(READUNCOMMITTED) WHERE NOT EXISTS(SELECT 1 FROM dw.Bridge_BillOfMaterials D WITH(READUNCOMMITTED) WHERE P.[BillOfMaterialsID]=D.[BillOfMaterialsID])</property>
