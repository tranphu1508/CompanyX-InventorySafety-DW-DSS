                  SQLTask:TimeOut="1800"
                  SQLTask:SqlStatementSource="DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context),@Previous bigint=(SELECT PreviousVersion FROM ssis_flow.Context),@Next bigint=(SELECT NextVersion FROM ssis_flow.Context);&#xA;IF @Previous IS NULL BEGIN&#xA;INSERT etl_raw.[BillOfMaterials]([BillOfMaterialsID],[ProductAssemblyID],[ComponentID],[StartDate],[EndDate],[UnitMeasureCode],[BOMLevel],[PerAssemblyQty],[ModifiedDate],LoadBatchID) SELECT S.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],@B FROM ssis_flow.Delta_BillOfMaterials S;&#xA;INSERT stg.[BillOfMaterials]([BillOfMaterialsID],[ProductAssemblyID],[ComponentID],[StartDate],[EndDate],[UnitMeasureCode],[BOMLevel],[PerAssemblyQty],[ModifiedDate],LoadBatchID) SELECT [BillOfMaterialsID],[ProductAssemblyID],[ComponentID],[StartDate],[EndDate],[UnitMeasureCode],[BOMLevel],[PerAssemblyQty],[ModifiedDate],@B FROM etl_raw.[BillOfMaterials];&#xA;INSERT etl_v2.SourceChange SELECT @B,N'Production.BillOfMaterials','I',@Next,(SELECT R.[BillOfMaterialsID] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER),NULL FROM etl_raw.[BillOfMaterials] R;&#xA;END ELSE BEGIN&#xA;SELECT [BillOfMaterialsID],CONVERT(char(1),FlowOperation) SYS_CHANGE_OPERATION,FlowVersion SYS_CHANGE_VERSION INTO #CT_BillOfMaterials FROM ssis_flow.Delta_BillOfMaterials;&#xA;INSERT etl_v2.SourceChange SELECT @B,N'Production.BillOfMaterials',C.SYS_CHANGE_OPERATION,C.SYS_CHANGE_VERSION,(SELECT C.[BillOfMaterialsID] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER),(SELECT R.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES) FROM #CT_BillOfMaterials C LEFT JOIN etl_raw.[BillOfMaterials] R ON R.[BillOfMaterialsID]=C.[BillOfMaterialsID];&#xA;DELETE R FROM etl_raw.[BillOfMaterials] R JOIN #CT_BillOfMaterials C ON R.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE C.SYS_CHANGE_OPERATION='D';&#xA;UPDATE R SET R.[ProductAssemblyID]=S.[ProductAssemblyID],R.[ComponentID]=S.[ComponentID],R.[StartDate]=S.[StartDate],R.[EndDate]=S.[EndDate],R.[UnitMeasureCode]=S.[UnitMeasureCode],R.[BOMLevel]=S.[BOMLevel],R.[PerAssemblyQty]=S.[PerAssemblyQty],R.[ModifiedDate]=S.[ModifiedDate],R.LoadBatchID=@B FROM etl_raw.[BillOfMaterials] R JOIN #CT_BillOfMaterials C ON R.[BillOfMaterialsID]=C.[BillOfMaterialsID] JOIN ssis_flow.Delta_BillOfMaterials S ON S.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D';&#xA;INSERT etl_raw.[BillOfMaterials]([BillOfMaterialsID],[ProductAssemblyID],[ComponentID],[StartDate],[EndDate],[UnitMeasureCode],[BOMLevel],[PerAssemblyQty],[ModifiedDate],LoadBatchID) SELECT S.[BillOfMaterialsID],S.[ProductAssemblyID],S.[ComponentID],S.[StartDate],S.[EndDate],S.[UnitMeasureCode],S.[BOMLevel],S.[PerAssemblyQty],S.[ModifiedDate],@B FROM #CT_BillOfMaterials C JOIN ssis_flow.Delta_BillOfMaterials S ON S.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D' AND NOT EXISTS(SELECT 1 FROM etl_raw.[BillOfMaterials] R WHERE R.[BillOfMaterialsID]=S.[BillOfMaterialsID]);&#xA;INSERT stg.[BillOfMaterials]([BillOfMaterialsID],[ProductAssemblyID],[ComponentID],[StartDate],[EndDate],[UnitMeasureCode],[BOMLevel],[PerAssemblyQty],[ModifiedDate],LoadBatchID) SELECT R.[BillOfMaterialsID],R.[ProductAssemblyID],R.[ComponentID],R.[StartDate],R.[EndDate],R.[UnitMeasureCode],R.[BOMLevel],R.[PerAssemblyQty],R.[ModifiedDate],@B FROM etl_raw.[BillOfMaterials] R JOIN #CT_BillOfMaterials C ON R.[BillOfMaterialsID]=C.[BillOfMaterialsID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D';&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
