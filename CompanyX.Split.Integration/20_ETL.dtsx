                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context WITH(READUNCOMMITTED)); SELECT P.[PurchaseOrderID],P.[PurchaseOrderDetailID],P.[OrderDateKey],P.[ExpectedShipDateKey],P.[ExpectedReceiptDateKey],P.[VendorKey],P.[ProductKey],P.[PurchaseStatusKey],P.[OrderQty],P.[ReceivedQty],P.[RejectedQty],P.[StockedQty],P.[UnitPrice],P.[LineTotal],P.[OrderAt],P.[ExpectedShipAt],P.[ExpectedReceiptAt],P.[IsVendorProductDeclared],P.[DQReasonCode],P.[DQRuleVersion],P.[LoadBatchID],P.[LoadedAt] FROM etl_calc.[Fact_PurchaseOrderLine] P WITH(READUNCOMMITTED) WHERE NOT EXISTS(SELECT 1 FROM dw.Fact_PurchaseOrderLine D WITH(READUNCOMMITTED) WHERE P.[PurchaseOrderID]=D.[PurchaseOrderID] AND P.[PurchaseOrderDetailID]=D.[PurchaseOrderDetailID])</property>
