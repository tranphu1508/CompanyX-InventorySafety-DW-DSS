                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context WITH(READUNCOMMITTED)); SELECT P.[LocationKey],P.[LocationID],P.[LocationName],P.[CostRate],P.[Availability],P.[LocationType],P.[HasProductionConflict],P.[LoadBatchID],P.[LoadedAt] FROM etl_calc.[Dim_Location] P WITH(READUNCOMMITTED) WHERE NOT EXISTS(SELECT 1 FROM dw.Dim_Location D WITH(READUNCOMMITTED) WHERE P.[LocationKey]=D.[LocationKey])</property>
