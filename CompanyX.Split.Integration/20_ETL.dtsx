          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\ETL - Mo tung nhom de xem Data Flow.EventHandlers[OnError]\Rollback DW va giu watermark cu"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:DelayValidation="True"
              DTS:DTSID="{B5608738-3D50-4BA9-ABFB-6315EF543412}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:FailParentOnFailure="True"
              DTS:LocaleID="-1"
              DTS:ObjectName="Rollback DW va giu watermark cu">
              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="SqlStatementSource">"IF XACT_STATE()&lt;&gt;0 ROLLBACK; SET TRANSACTION ISOLATION LEVEL READ COMMITTED; DECLARE @B bigint=" + (DT_WSTR,30)@[User::BatchId] + "; IF @B&gt;0 BEGIN UPDATE etl.ETL_LoadBatch SET Status='FAILED',ValidationStatus='FAILED',LoadCompletedAt=SYSUTCDATETIME(),ErrorMessage='SSIS Data Flow failed; all target/raw/watermark writes rolled back. See Progress log.' WHERE LoadBatchID=@B AND Status='RUNNING'; UPDATE etl_v2.BatchState SET Status='FAILED',ErrorMessage='SSIS Data Flow rollback; see package log' WHERE BatchID=@B AND Status='RUNNING'; END; IF APPLOCK_MODE('public','InventorySafety_FullLoad','Session')&lt;&gt;'NoLock' EXEC sys.sp_releaseapplock @Resource='InventorySafety_FullLoad',@LockOwner='Session'; IF APPLOCK_MODE('public','DSS_RESULT','Session')&lt;&gt;'NoLock' EXEC sys.sp_releaseapplock @Resource='DSS_RESULT',@LockOwner='Session';"</DTS:PropertyExpression>
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{3B8653A6-4D79-41A5-8B6F-0DBB6C4B12C7}"
                  SQLTask:TimeOut="1800"
                  SQLTask:SqlStatementSource="IF XACT_STATE()&lt;&gt;0 ROLLBACK; SET TRANSACTION ISOLATION LEVEL READ COMMITTED; DECLARE @B bigint=0; IF @B&gt;0 BEGIN UPDATE etl.ETL_LoadBatch SET Status='FAILED',ValidationStatus='FAILED',LoadCompletedAt=SYSUTCDATETIME(),ErrorMessage='SSIS Data Flow failed; all target/raw/watermark writes rolled back. See Progress log.' WHERE LoadBatchID=@B AND Status='RUNNING'; UPDATE etl_v2.BatchState SET Status='FAILED',ErrorMessage='SSIS Data Flow rollback; see package log' WHERE BatchID=@B AND Status='RUNNING'; END; IF APPLOCK_MODE('public','InventorySafety_FullLoad','Session')&lt;&gt;'NoLock' EXEC sys.sp_releaseapplock @Resource='InventorySafety_FullLoad',@LockOwner='Session'; IF APPLOCK_MODE('public','DSS_RESULT','Session')&lt;&gt;'NoLock' EXEC sys.sp_releaseapplock @Resource='DSS_RESULT',@LockOwner='Session';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
        </DTS:EventHandler>
      </DTS:EventHandlers>
    </DTS:Executable>
  </DTS:Executables>
