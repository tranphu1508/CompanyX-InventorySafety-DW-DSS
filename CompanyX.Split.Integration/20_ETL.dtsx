RuleVersion],D.[LoadBatchID]=P.[LoadBatchID],D.[LoadedAt]=P.[LoadedAt] FROM dw.Fact_PurchaseOrderLine D JOIN etl_calc.[Fact_PurchaseOrderLine] P ON P.[PurchaseOrderID]=D.[PurchaseOrderID] AND P.[PurchaseOrderDetailID]=D.[PurchaseOrderDetailID] WHERE EXISTS(SELECT P.[OrderDateKey],P.[ExpectedShipDateKey],P.[ExpectedReceiptDateKey],P.[VendorKey],P.[ProductKey],P.[PurchaseStatusKey],P.[OrderQty],P.[ReceivedQty],P.[RejectedQty],P.[StockedQty],P.[UnitPrice],P.[LineTotal],P.[OrderAt],P.[ExpectedShipAt],P.[ExpectedReceiptAt],P.[IsVendorProductDeclared],P.[DQReasonCode],P.[DQRuleVersion] EXCEPT SELECT D.[OrderDateKey],D.[ExpectedShipDateKey],D.[ExpectedReceiptDateKey],D.[VendorKey],D.[ProductKey],D.[PurchaseStatusKey],D.[OrderQty],D.[ReceivedQty],D.[RejectedQty],D.[StockedQty],D.[UnitPrice],D.[LineTotal],D.[OrderAt],D.[ExpectedShipAt],D.[ExpectedReceiptAt],D.[IsVendorProductDeclared],D.[DQReasonCode],D.[DQRuleVersion]);&#xA;INSERT etl_v2.TargetChange(BatchID,TableName,Operation,KeyJson,BeforeJson,AfterJson) SELECT @B,N'dw.Fact_PurchaseOrderLine','I',(SELECT P.[PurchaseOrderID],P.[PurchaseOrderDetailID] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES),NULL,(SELECT P.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES) FROM etl_calc.[Fact_PurchaseOrderLine] P WHERE NOT EXISTS(SELECT 1 FROM dw.Fact_PurchaseOrderLine D WHERE P.[PurchaseOrderID]=D.[PurchaseOrderID] AND P.[PurchaseOrderDetailID]=D.[PurchaseOrderDetailID]);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
