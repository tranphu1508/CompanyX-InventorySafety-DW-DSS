                  SQLTask:SqlStatementSource="DECLARE @B bigint=(SELECT BatchId FROM ssis_flow.Context),@Previous bigint=(SELECT PreviousVersion FROM ssis_flow.Context),@Next bigint=(SELECT NextVersion FROM ssis_flow.Context);&#xA;IF @Previous IS NULL BEGIN&#xA;INSERT etl_raw.[Customer]([CustomerID],[PersonID],[StoreID],[TerritoryID],[AccountNumber],[rowguid],[ModifiedDate],LoadBatchID) SELECT S.[CustomerID],S.[PersonID],S.[StoreID],S.[TerritoryID],S.[AccountNumber],S.[rowguid],S.[ModifiedDate],@B FROM ssis_flow.Delta_Customer S;&#xA;INSERT stg.[Customer]([CustomerID],[PersonID],[StoreID],[TerritoryID],[AccountNumber],[rowguid],[ModifiedDate],LoadBatchID) SELECT [CustomerID],[PersonID],[StoreID],[TerritoryID],[AccountNumber],[rowguid],[ModifiedDate],@B FROM etl_raw.[Customer];&#xA;INSERT etl_v2.SourceChange SELECT @B,N'Sales.Customer','I',@Next,(SELECT R.[CustomerID] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER),NULL FROM etl_raw.[Customer] R;&#xA;END ELSE BEGIN&#xA;SELECT [CustomerID],CONVERT(char(1),FlowOperation) SYS_CHANGE_OPERATION,FlowVersion SYS_CHANGE_VERSION INTO #CT_Customer FROM ssis_flow.Delta_Customer;&#xA;INSERT etl_v2.SourceChange SELECT @B,N'Sales.Customer',C.SYS_CHANGE_OPERATION,C.SYS_CHANGE_VERSION,(SELECT C.[CustomerID] FOR JSON PATH,WITHOUT_ARRAY_WRAPPER),(SELECT R.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES) FROM #CT_Customer C LEFT JOIN etl_raw.[Customer] R ON R.[CustomerID]=C.[CustomerID];&#xA;DELETE R FROM etl_raw.[Customer] R JOIN #CT_Customer C ON R.[CustomerID]=C.[CustomerID] WHERE C.SYS_CHANGE_OPERATION='D';&#xA;UPDATE R SET R.[PersonID]=S.[PersonID],R.[StoreID]=S.[StoreID],R.[TerritoryID]=S.[TerritoryID],R.[AccountNumber]=S.[AccountNumber],R.[rowguid]=S.[rowguid],R.[ModifiedDate]=S.[ModifiedDate],R.LoadBatchID=@B FROM etl_raw.[Customer] R JOIN #CT_Customer C ON R.[CustomerID]=C.[CustomerID] JOIN ssis_flow.Delta_Customer S ON S.[CustomerID]=C.[CustomerID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D';&#xA;INSERT etl_raw.[Customer]([CustomerID],[PersonID],[StoreID],[TerritoryID],[AccountNumber],[rowguid],[ModifiedDate],LoadBatchID) SELECT S.[CustomerID],S.[PersonID],S.[StoreID],S.[TerritoryID],S.[AccountNumber],S.[rowguid],S.[ModifiedDate],@B FROM #CT_Customer C JOIN ssis_flow.Delta_Customer S ON S.[CustomerID]=C.[CustomerID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D' AND NOT EXISTS(SELECT 1 FROM etl_raw.[Customer] R WHERE R.[CustomerID]=S.[CustomerID]);&#xA;INSERT stg.[Customer]([CustomerID],[PersonID],[StoreID],[TerritoryID],[AccountNumber],[rowguid],[ModifiedDate],LoadBatchID) SELECT R.[CustomerID],R.[PersonID],R.[StoreID],R.[TerritoryID],R.[AccountNumber],R.[rowguid],R.[ModifiedDate],@B FROM etl_raw.[Customer] R JOIN #CT_Customer C ON R.[CustomerID]=C.[CustomerID] WHERE C.SYS_CHANGE_OPERATION&lt;&gt;'D';&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
