        DTS:DataType="8">DECLARE @Previous bigint=-1,@Next bigint=0; DECLARE @CTPrevious bigint=CASE WHEN @Previous&lt;0 THEN 0 ELSE @Previous END; SELECT S.[TransactionID],S.[ProductID],S.[ReferenceOrderID],S.[ReferenceOrderLineID],S.[TransactionDate],S.[TransactionType],S.[Quantity],S.[ActualCost],S.[ModifiedDate],CONVERT(nvarchar(1),N'I') FlowOperation,CONVERT(bigint,@Next) FlowVersion FROM [Production].[TransactionHistory] S WHERE @Previous&lt;0 UNION ALL SELECT C.[TransactionID],S.[ProductID],S.[ReferenceOrderID],S.[ReferenceOrderLineID],S.[TransactionDate],S.[TransactionType],S.[Quantity],S.[ActualCost],S.[ModifiedDate],CONVERT(nvarchar(1),C.SYS_CHANGE_OPERATION) FlowOperation,C.SYS_CHANGE_VERSION FlowVersion FROM CHANGETABLE(CHANGES [Production].[TransactionHistory],@CTPrevious) C LEFT JOIN [Production].[TransactionHistory] S ON S.[TransactionID]=C.[TransactionID] WHERE @Previous&gt;=0 AND C.SYS_CHANGE_VERSION&lt;=@Next;</DTS:VariableValue>
