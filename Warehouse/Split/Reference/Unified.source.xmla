></Dimensions><Partitions><Partition><ID>PlanOrderMaterial_PublishedDetail</ID><Name>PlanOrderMaterial_PublishedDetail</Name><Source xsi:type="QueryBinding"><DataSourceID>CompanyXSource</DataSourceID><QueryDefinition>SELECT * FROM cxdetail.[FactPlanOrderMaterial]</QueryDefinition></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup></MeasureGroups>
          <Source>
            <DataSourceViewID>CompanyXSourceView</DataSourceViewID>
          </Source>
          <MdxScripts>
            <MdxScript>
              <ID>Calculations</ID>
              <Name>Calculations</Name>
              <Commands>
                <Command>
                  <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[On Hand Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal On Hand Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[WIP Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal WIP Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Inventory Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Inventory Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Owned In Transit Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Owned In Transit Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Line Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Line Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Completed Line Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Completed Line Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Due Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[On Time Full Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal On Time Full Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Lost Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Lost Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Open Due Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Open Due Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Solve Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Solve Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Feasible Solve Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Feasible Solve Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Optimal Solve Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Optimal Solve Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Feasible Time Limit Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Feasible Time Limit Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Gap Observed Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Gap Observed Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Solver Seconds] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Solver Seconds]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Max Relative Gap] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Max Relative Gap]),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Simulated Calendar Days] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Simulated Calendar Days]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='RunDay', ASSOCIATED_MEASURE_GROUP='RunDay';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Run Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Run Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Manufactured Due Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Manufactured Due Qty]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Manufactured On Time Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Manufactured On Time Qty]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Average Inventory Value] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Average Inventory Value]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Due Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Due Order Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit On Time Full Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit On Time Full Order Count]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Wall Clock Seconds] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Wall Clock Seconds]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Solver Seconds] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Audit Solver Seconds]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
CREATE MEMBER CURRENTCUBE.[Measures].[On Hand Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw On Hand Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[WIP Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw WIP Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Queued Production Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Queued Production Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Open Purchase Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Open Purchase Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Backlog Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Backlog Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase In Transit Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase In Transit Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Due Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Due Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily On Time Delivered Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily On Time Delivered Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Late Delivered Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Late Delivered Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Lost Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Lost Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[BOM Consumed Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw BOM Consumed Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase Accepted Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase Accepted Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase Rejected Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase Rejected Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Production Good Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Production Good Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort Demand Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Due Cohort Demand Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort On Time Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Due Cohort On Time Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort Filled Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Due Cohort Filled Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort Lost Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Due Cohort Lost Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort Ending Backlog Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Due Cohort Ending Backlog Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Late Unit Days] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Line Unit Key Min]) AND [Measures].[Line Unit Key Min]=[Measures].[Line Unit Key Max],[Measures].[Raw Late Unit Days],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Average Inventory Value] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(ISEMPTY([Measures].[Inventory Value Day Sum]) OR VALIDMEASURE(([Measures].[Internal Simulated Calendar Days]))&lt;=0,NULL,[Measures].[Inventory Value Day Sum]/VALIDMEASURE(([Measures].[Internal Simulated Calendar Days])))),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[On Time Unit Rate] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Due Cohort Demand Qty]&gt;0,[Measures].[Due Cohort On Time Qty]/[Measures].[Due Cohort Demand Qty],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Cohort Fill Rate] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Due Cohort Demand Qty]&gt;0,[Measures].[Due Cohort Filled Qty]/[Measures].[Due Cohort Demand Qty],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Mean Completed Line Late Days] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Completed Line Count]&gt;0,[Measures].[Completion Late Days Sum]/[Measures].[Completed Line Count],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Whole Order OTIF] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Due Order Count]&gt;0,[Measures].[On Time Full Order Count]/[Measures].[Due Order Count],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Feasible Time Limit Rate] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Solve Count]&gt;0,[Measures].[Feasible Time Limit Count]/[Measures].[Solve Count],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Mean Relative Gap] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Gap Observed Count]&gt;0,[Measures].[Relative Gap Sum]/[Measures].[Gap Observed Count],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Solve Objective Value] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Internal Solve Count]=1,[Measures].[Raw Objective Value],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Solve Best Bound] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Internal Solve Count]=1,[Measures].[Raw Best Bound],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SolveAudit', ASSOCIATED_MEASURE_GROUP='SolveAudit';
CREATE MEMBER CURRENTCUBE.[Measures].[Audit Manufactured OTU] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Audit Manufactured Due Qty]&gt;0,[Measures].[Audit Manufactured On Time Qty]/[Measures].[Audit Manufactured Due Qty],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='RunSummary', ASSOCIATED_MEASURE_GROUP='RunSummary';
// A run is an experiment outcome; do not sum across replications/policies.
// Every visible measure has an explicit single-run guard; hidden raw measures are internal aggregation helpers.
ALTER CUBE CURRENTCUBE UPDATE DIMENSION Measures, DEFAULT_MEMBER=[Measures].[Inventory Value EOD];
