@{ Layout = "_DssLayout"; ViewData["Page"] = "operations"; ViewData["Title"] = "Tổng quan vận hành"; }
<div class="page-intro reveal"><div><span class="section-kicker">BÁO CÁO VẬN HÀNH</span><h1>Tổng quan hiệu quả tồn kho</h1><p>So sánh hiệu quả giao hàng và tồn kho giữa các chính sách vận hành.</p></div><span class="page-badge">Phân tích vận hành</span></div>
<section class="surface filter-panel reveal"><div class="row g-3 align-items-end"><div class="col-sm-6 col-xl-3"><label for="period" class="form-label">Giai đoạn</label><select id="period" class="form-select"><option value="" selected></option></select></div><div class="col-sm-6 col-xl-3"><label for="comparePolicy" class="form-label">Chính sách so sánh</label><select id="comparePolicy" class="form-select"><option value="" selected></option><option value="rop-adapt">ROP và Quetschlich Adapt</option></select></div><div class="col-sm-6 col-xl-3"><label for="compareRule" class="form-label">Quy tắc giao</label><select id="compareRule" class="form-select"><option value="" selected></option></select></div><div class="col-sm-6 col-xl-3"><div class="form-label">Xem theo</div><div class="btn-group period-switch w-100" role="group" aria-label="Đơn vị thời gian"><button class="btn active" type="button" data-period="tháng" aria-pressed="true">Tháng</button><button class="btn" type="button" data-period="quý" aria-pressed="false">Quý</button></div></div></div></section>
<div class="section-heading reveal"><div><span class="section-kicker">CẢ GIAI ĐOẠN</span><h2>Chỉ số so sánh</h2></div><div class="policy-legend"><span><i class="legend-dot gray"></i>ROP</span><span><i class="legend-dot blue"></i>Quetschlich Adapt</span></div></div>
<div class="row g-3 mb-4 comparison-metrics"><div class="col-sm-6 col-xl"><div class="surface compare-card"><span>Lost sales</span><strong data-metric="overviewLostSales"></strong><small>Đơn vị</small></div></div><div class="col-sm-6 col-xl"><div class="surface compare-card"><span>Lượng giao được</span><strong data-metric="deliveredUnits"></strong><small>Đơn vị</small></div></div><div class="col-sm-6 col-xl"><div class="surface compare-card"><span>Số đơn giao được</span><strong data-metric="deliveredOrders"></strong><small>Đơn hàng</small></div></div><div class="col-sm-6 col-xl"><div class="surface compare-card"><span>Tồn bình quân</span><strong data-metric="averageStock"></strong><small>Đơn vị</small></div></div><div class="col-sm-6 col-xl"><div class="surface compare-card"><span>Giá trị tồn bình quân</span><strong data-metric="averageValue"></strong><small>Triệu</small></div></div></div>
<div class="row g-3 g-xl-4 mb-4"><div class="col-xl-4"><article class="surface panel h-100"><div class="panel-heading"><div><span class="section-kicker">CƠ CẤU</span><h3>Phân bổ hiệu quả giao</h3></div></div><div class="operations-donut delivery-comparison"><figure><figcaption>ROP</figcaption><div class="delivery-ring"><canvas id="deliveryRopDonut" aria-label="Phân bổ hiệu quả giao của ROP"></canvas></div></figure><figure><figcaption>MILP</figcaption><div class="delivery-ring"><canvas id="deliveryMilpDonut" aria-label="Phân bổ hiệu quả giao của MILP"></canvas></div></figure></div><div class="chart-legend justify-content-center"><span><i class="legend-dot teal"></i>Đúng hạn</span><span><i class="legend-dot amber"></i>Trễ hạn</span><span><i class="legend-dot gray"></i>Mất đơn</span></div></article></div><div class="col-xl-8"><article class="surface panel h-100"><div class="panel-heading"><div><span class="section-kicker">DIỄN BIẾN</span><h3>Lost sales theo <span data-period-label>tháng</span></h3></div><div class="policy-legend"><span><i class="legend-dot gray"></i>ROP</span><span><i class="legend-dot blue"></i>Tối ưu</span></div></div><div class="empty-chart-grid tall"><span>Đang tải xu hướng</span></div></article></div></div>
<div class="row g-3 g-xl-4"><div class="col-xl-5"><article class="surface panel h-100"><div class="panel-heading"><div><span class="section-kicker">GỢI Ý VẬN HÀNH</span><h3>Điểm cần lưu ý</h3></div><span class="insight-symbol"><svg class="icon"><use href="#icon-spark"/></svg></span></div><div class="recommendation-empty" id="recommendations">Đang tổng hợp dữ liệu vận hành.</div><button class="btn btn-soft w-100 mt-3" type="button" id="optimizeButton">Làm mới báo cáo <svg class="icon"><use href="#icon-arrow"/></svg></button><div id="optimizeMessage" class="form-feedback" role="status" hidden></div></article></div><div class="col-xl-7"><article class="surface panel h-100"><div class="panel-heading"><div><span class="section-kicker">DỮ LIỆU CHI TIẾT</span><h3>Số liệu theo <span data-period-label>tháng</span></h3></div></div><div class="table-responsive"><table class="table dss-table align-middle mb-0"><thead><tr><th>Kỳ</th><th>Đơn đến hạn</th><th>Lost sales</th><th>Giao được</th><th>Tồn bình quân</th><th>Giá trị tồn</th></tr></thead><tbody id="monthlyRows"><tr><td colspan="6" class="table-empty">Đang tải số liệu</td></tr></tbody></table></div></article></div></div>
