<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111d3a">
  <title>@ViewData["Title"] · DSS CompanyX</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/dss.css" asp-append-version="true">
</head>
<body data-page="@ViewData["Page"]">
  <svg class="svg-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
    <symbol id="icon-box" viewBox="0 0 24 24"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Z"/><path d="m3 7 9 4 9-4M12 11v10"/></symbol>
    <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M3 20h18M6 16V9m6 7V4m6 12v-6"/></symbol>
    <symbol id="icon-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></symbol>
    <symbol id="icon-spark" viewBox="0 0 24 24"><path d="m12 2 1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2ZM19 17l.7 2.3L22 20l-2.3.7L19 23l-.7-2.3L16 20l2.3-.7L19 17Z"/></symbol>
    <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
    <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
    <symbol id="icon-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></symbol>
  </svg>
  <header class="app-topbar top-nav">
    <nav class="navbar navbar-expand-lg w-100" aria-label="Điều hướng chính">
      <div class="container-fluid px-0">
        <a class="navbar-brand top-brand" href="/"><span class="brand-mark"><svg class="icon"><use href="#icon-layers"/></svg></span><span><strong>CompanyX</strong><small>DSS INVENTORY</small></span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu"><svg class="icon"><use href="#icon-menu"/></svg></button>
        <div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav top-links mx-lg-auto">
          <a class="nav-link @(ViewData["Page"] as string == "dashboard" ? "active" : "")" href="/"><svg class="icon"><use href="#icon-grid"/></svg>Dashboard</a>
          <a class="nav-link @(ViewData["Page"] as string == "orders" ? "active" : "")" href="/Orders"><svg class="icon"><use href="#icon-box"/></svg>Đơn hàng lớn</a>
          <a class="nav-link @(ViewData["Page"] as string == "operations" ? "active" : "")" href="/Operations"><svg class="icon"><use href="#icon-chart"/></svg>Tổng quan vận hành</a>
        </div></div>
        <div class="topbar-right"><div class="top-run-select"><span>Kịch bản</span><select id="runSelect" class="form-select form-select-sm" aria-label="Kịch bản phân tích"></select></div><span id="connectionDot" class="connection-dot"></span><span class="avatar">CX</span></div>
      </div>
    </nav>
  </header>
  <main class="content-wrap page-content">@RenderBody()</main>
  <footer class="page-footer"><span>CompanyX DSS · Hỗ trợ quyết định tồn kho</span><span id="connectionLabel">Đang đồng bộ dữ liệu</span></footer>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
  <script src="~/lib/chart.js/chart.umd.js" asp-append-version="true"></script>
  <script src="~/js/dss.js" asp-append-version="true"></script>
</body>
</html>
