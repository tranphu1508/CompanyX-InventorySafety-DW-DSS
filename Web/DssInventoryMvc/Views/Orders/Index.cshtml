@{ Layout = "_DssLayout"; ViewData["Page"] = "orders"; ViewData["Title"] = "Đơn hàng lớn"; }
<div class="page-intro reveal"><div><span class="section-kicker">PHÂN TÍCH ĐƠN HÀNG</span><h1>Quyết định cho đơn hàng lớn</h1><p>Đánh giá khả năng đáp ứng đơn hàng và tham khảo các phương án giao hàng.</p></div><span class="page-badge">Kịch bản đơn hàng</span></div>
<div class="row g-3 g-xl-4 align-items-start">
  <div class="col-xl-4"><section class="surface panel form-panel reveal"><div class="panel-heading"><div><span class="section-kicker">THÔNG TIN ĐẦU VÀO</span><h3>Chọn đơn lớn</h3></div><span class="step-badge">01</span></div><form id="orderForm" novalidate>
  <div class="mb-3"><label for="product" class="form-label">Sản phẩm</label><select id="product" name="product" class="form-select"><option value="">Chọn mẫu xe đạp</option></select></div>
  <div class="mb-3"><label for="quantity" class="form-label">Số lượng đơn</label><input id="quantity" name="quantity" type="number" class="form-control" min="1" step="1" required></div>
  <div class="row g-3 mb-3"><div class="col-sm-6"><label for="receivedDate" class="form-label">Ngày biết đơn</label><input id="receivedDate" name="receivedDate" type="date" class="form-control"></div><div class="col-sm-6"><label for="dueDate" class="form-label">Ngày cần giao</label><input id="dueDate" name="dueDate" type="date" class="form-control" required></div></div>
  <button id="searchDeadlineButton" class="btn btn-primary dss-primary w-100" type="submit">Tìm phương án <svg class="icon"><use href="#icon-arrow"/></svg></button>
  <div id="simulationMessage" class="form-feedback" role="status" hidden></div>
</form><div class="form-divider"></div><h4 class="subheading">Trạng thái xử lý</h4><div class="status-timeline"><div><i></i><span>Đánh giá khả năng đáp ứng</span><output></output></div><div><i></i><span>Kiểm tra tồn kho sản phẩm</span><output></output></div><div><i></i><span>Đối chiếu kế hoạch sản xuất</span><output></output></div><div><i></i><span>Hoàn tất phân tích</span><output></output></div></div></section></div>
  <div class="col-xl-8"><div class="section-heading order-heading"><div><span class="section-kicker">TÌNH TRẠNG HIỆN TẠI</span><h2>Hiện trạng khi nhận đơn</h2></div></div><div class="row g-3 mb-4"><div class="col-sm-6 col-xxl-3"><div class="surface compact-metric"><span>Tồn thành phẩm</span><strong id="stock" data-metric="orderFinishedStock"></strong><small id="stockLabel">Đơn vị hiện có</small></div></div><div class="col-sm-6 col-xxl-3"><div class="surface compact-metric"><span>Số lượng yêu cầu</span><strong id="demand" data-metric="largeOrderQuantity"></strong><small id="dueLabel">Đơn vị</small></div></div><div class="col-sm-6 col-xxl-3"><div class="surface compact-metric"><span>Nhu cầu bổ sung</span><strong id="shortage" data-metric="productionNeed"></strong><small id="dueLabel">Đơn vị</small></div></div><div class="col-sm-6 col-xxl-3"><div class="surface compact-metric"><span>Thành phần sản xuất</span><strong id="components" data-metric="missingComponents"></strong><small id="componentList">Mã thành phần trực tiếp</small></div></div></div>
    <section class="surface panel mb-4 reveal"><div class="panel-heading"><div><span class="section-kicker">GỢI Ý QUYẾT ĐỊNH</span><h3>Phương án giao cho đơn nhập</h3></div><span class="small-status"><span></span>Đánh giá khả năng giao</span></div><div class="insight-banner"><span class="insight-symbol"><svg class="icon"><use href="#icon-spark"/></svg></span><div><strong>Nhận định nhanh</strong><p id="orderAdvice" aria-live="polite">&nbsp;</p></div></div><div class="row g-3 scenario-row"><div class="col-lg-4"><label class="scenario-card"><input type="radio" name="scenario" value="A" disabled><span class="scenario-header"><b>A</b><strong>Giao đúng hạn</strong></span><span class="scenario-description">Chưa có kết quả đã lưu</span><span class="scenario-details"></span></label></div><div class="col-lg-4"><label class="scenario-card"><input type="radio" name="scenario" value="B" disabled><span class="scenario-header"><b>B</b><strong>Hạn giao mới</strong></span><span class="scenario-description">Chưa có kết quả đã lưu</span><span class="scenario-details"></span></label></div><div class="col-lg-4"><label class="scenario-card"><input type="radio" name="scenario" value="C" disabled><span class="scenario-header"><b>C</b><strong>Từ chối đơn</strong></span><span class="scenario-description">Chưa có kết quả đã lưu</span><span class="scenario-details"></span></label></div></div></section>
    <section class="surface panel reveal" id="productionPlan"><div class="panel-heading"><div><span class="section-kicker">KẾ HOẠCH SẢN XUẤT</span><h3 id="planTitle">Kế hoạch sản xuất</h3></div></div><div class="schedule-placeholder"><div class="schedule-labels"><span>Mặt hàng</span><span></span><span></span></div><div class="schedule-grid"><div></div><div></div><div></div></div><span class="schedule-empty" id="planNote">Chọn phương án có kết quả để xem kế hoạch.</span></div><div class="table-responsive" hidden><table class="table dss-table align-middle mb-0"><thead><tr><th>#</th><th>Mặt hàng</th><th>Số lượng cho đơn</th><th>Phát hành</th><th>Khởi công</th><th>Hoàn thành</th><th>Số ngày</th></tr></thead><tbody id="productionRows"><tr><td colspan="7" class="table-empty">Chọn đơn đã mô phỏng để đọc dữ liệu</td></tr></tbody></table></div></section>
  </div>
</div>

<script src="~/js/order-replay.js" asp-append-version="true"></script>
