@{ Layout = "_DssLayout"; ViewData["Page"] = "dashboard"; ViewData["Title"] = "Dashboard"; }
<div class="hero-card reveal"><div class="hero-copy"><span class="eyebrow"><svg class="icon"><use href="#icon-spark"/></svg> TRUNG TÂM ĐIỀU HÀNH</span><h1>Toàn cảnh tồn kho.<br><span>Quyết định rõ ràng hơn.</span></h1><p>Quan sát đơn hàng, tồn kho và phương án sản xuất trong một không gian làm việc. Theo dõi hiệu quả tồn kho, mức độ đáp ứng đơn hàng và xu hướng vận hành theo thời gian.</p><div class="hero-actions"><button class="btn btn-light btn-lg" type="button" data-open-tab="#nav-order">Nhập đơn lớn <svg class="icon"><use href="#icon-arrow"/></svg></button><button class="btn btn-hero-outline btn-lg" type="button" data-open-tab="#nav-operations">Xem vận hành</button></div></div><div class="hero-visual" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="visual-card visual-card-back"></div><div class="visual-card visual-card-front"><span class="visual-line long"></span><span class="visual-line short"></span><div class="visual-ring"><div></div></div><span class="visual-line medium"></span></div><span class="hero-glow"></span></div></div>

<div class="section-heading reveal"><div><span class="section-kicker">TỔNG QUAN NHANH</span><h2>Chỉ số trọng tâm</h2></div><span class="section-note">Theo kịch bản đang chọn</span></div>
<div class="row g-3 g-xl-4 mb-4" id="dashboardMetrics">
  <div class="col-sm-6 col-xl-3"><article class="surface metric-card reveal" style="--delay:1"><div class="metric-top"><span>Tồn thành phẩm</span><span class="metric-icon blue"><svg class="icon"><use href="#icon-box"/></svg></span></div><div class="metric-empty" data-metric="finishedStock"></div><div class="metric-foot">Đơn vị hiện có</div></article></div>
  <div class="col-sm-6 col-xl-3"><article class="surface metric-card reveal" style="--delay:2"><div class="metric-top"><span>Tồn đơn cuối kỳ</span><span class="metric-icon violet"><svg class="icon"><use href="#icon-layers"/></svg></span></div><div class="metric-empty" data-metric="pendingOrders"></div><div class="metric-foot">Đơn vị</div></article></div>
  <div class="col-sm-6 col-xl-3"><article class="surface metric-card reveal" style="--delay:3"><div class="metric-top"><span>Tỷ lệ giao đúng hạn</span><span class="metric-icon teal"><svg class="icon"><use href="#icon-chart"/></svg></span></div><div class="metric-empty" data-metric="onTimeRate"></div><div class="metric-foot">Theo giai đoạn</div></article></div>
  <div class="col-sm-6 col-xl-3"><article class="surface metric-card reveal" style="--delay:4"><div class="metric-top"><span>Lost sales</span><span class="metric-icon amber"><svg class="icon"><use href="#icon-chart"/></svg></span></div><div class="metric-empty" data-metric="lostSales"></div><div class="metric-foot">Đơn vị</div></article></div>
</div>

<div class="row g-3 g-xl-4 mb-4">
  <div class="col-xl-8"><article class="surface panel h-100 reveal"><div class="panel-heading"><div><span class="section-kicker">PHÂN BỔ</span><h3>Cơ cấu tồn kho &amp; đơn hàng</h3></div><span class="small-status"><span></span>Cập nhật theo kịch bản</span></div><div class="row g-3 donut-row"><div class="col-md-6"><div class="chart-tile"><h4>Cơ cấu tồn kho</h4><p>Thành phẩm, linh kiện, WIP</p><div class="donut-stage"><div class="donut-placeholder"><span>Đang tải<br>biểu đồ</span></div><canvas id="inventoryDonut" hidden aria-label="Biểu đồ cơ cấu tồn kho"></canvas></div><div class="chart-legend"><span><i class="legend-dot blue"></i>Thành phẩm</span><span><i class="legend-dot teal"></i>Linh kiện</span><span><i class="legend-dot violet"></i>WIP</span></div></div></div><div class="col-md-6"><div class="chart-tile"><h4>Trạng thái đơn hàng</h4><p>Đúng hạn, chờ xử lý, trễ hạn</p><div class="donut-stage"><div class="donut-placeholder"><span>Đang tải<br>biểu đồ</span></div><canvas id="orderDonut" hidden aria-label="Biểu đồ trạng thái đơn hàng"></canvas></div><div class="chart-legend"><span><i class="legend-dot teal"></i>Đúng hạn</span><span><i class="legend-dot blue"></i>Giao trễ</span><span><i class="legend-dot amber"></i>Mất đơn</span></div></div></div></div></article></div>
  <div class="col-xl-4"><article class="surface panel h-100 reveal"><div class="panel-heading"><div><span class="section-kicker">QUY TRÌNH DSS</span><h3>Luồng ra quyết định</h3></div></div><div class="workflow-list"><div class="workflow-item"><span class="workflow-step">01</span><div><strong>Tiếp nhận đơn lớn</strong><small>Khách hàng, sản phẩm, thời hạn</small></div><span class="workflow-state"></span></div><div class="workflow-item"><span class="workflow-step">02</span><div><strong>Đối chiếu tồn kho</strong><small>Thành phẩm và linh kiện</small></div><span class="workflow-state"></span></div><div class="workflow-item"><span class="workflow-step">03</span><div><strong>So sánh phương án</strong><small>Giao ngay, dời hạn, từ chối</small></div><span class="workflow-state"></span></div><div class="workflow-item"><span class="workflow-step">04</span><div><strong>Lập kế hoạch</strong><small>Phát hành và sản xuất</small></div><span class="workflow-state"></span></div></div><button class="btn btn-soft w-100" type="button" data-open-tab="#nav-order">Phân tích đơn hàng <svg class="icon"><use href="#icon-arrow"/></svg></button></article></div>
</div>

<div class="row g-3 g-xl-4"><div class="col-xl-7"><article class="surface panel h-100 reveal"><div class="panel-heading"><div><span class="section-kicker">XU HƯỚNG</span><h3>Lost sales theo kỳ</h3></div></div><div id="dashboardTrend" class="empty-chart-grid"><span>Đang tải xu hướng</span></div></article></div><div class="col-xl-5"><article class="surface panel h-100 reveal"><div class="panel-heading"><div><span class="section-kicker">KẾ HOẠCH</span><h3>Hoạt động sản xuất</h3></div><button class="link-button" type="button" data-open-tab="#nav-order">Xem chi tiết <svg class="icon"><use href="#icon-arrow"/></svg></button></div><div class="empty-list" id="dashboardProduction"><div class="empty-list-line"></div><div class="empty-list-line"></div><div class="empty-list-line"></div><span>Đang tải hoạt động sản xuất</span></div></article></div></div>
