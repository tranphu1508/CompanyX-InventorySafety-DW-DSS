        {
          "name": "Due Open Customer Orders EOD",
          "column": "DueOpenOrderFlag",
          "aggregation": "Sum",
          "format": "#,##0",
          "description": ""
        },
        {
          "name": "Customer Orders Completed Today",
          "column": "CompletedTodayFlag",
          "aggregation": "Sum",
          "format": "#,##0",
          "description": "",
          "guards": [
            "Run"
          ],
          "single_date_role": null
        },
        {
          "name": "Customer Orders Lost Today",
          "column": "LostTodayFlag",
          "aggregation": "Sum",
          "format": "#,##0",
          "description": "",
          "guards": [
            "Run"
          ],
          "single_date_role": null
