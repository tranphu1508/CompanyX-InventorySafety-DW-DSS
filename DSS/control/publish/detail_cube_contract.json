        {
          "id": "Run",
          "column": "PlanningRunKey"
        },
        {
          "id": "Day",
          "column": "DateKey"
        }
      ],
      "measures": [
        {
          "name": "Open Customer Orders EOD",
          "column": "OpenOrderFlag",
          "aggregation": "Sum",
          "format": "#,##0",
          "description": "All known orders still open at end of the selected simulation day, including future due orders."
