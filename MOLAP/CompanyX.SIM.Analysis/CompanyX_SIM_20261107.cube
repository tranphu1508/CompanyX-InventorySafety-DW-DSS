CREATE MEMBER CURRENTCUBE.[Measures].[All SKU End Backlog Rate] AS IIF([Measures].[All SKU Due Cohort Demand Qty]&gt;0,[Measures].[All SKU Due Cohort Ending Backlog Qty]/[Measures].[All SKU Due Cohort Demand Qty],NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Open Due Order Count] AS IIF([Measures].[Due Order Count]&gt;0 AND COUNT(TAIL(NONEMPTY(GENERATE(EXISTING [Due Date].[Date].[Date].MEMBERS,{LINKMEMBER([Due Date].[Date].CURRENTMEMBER,[Simulation Date].[Date])}),{[Measures].[Internal KPI Calendar Days]}),1))=1,COALESCEEMPTY(SUM(TAIL(NONEMPTY(GENERATE(EXISTING [Due Date].[Date].[Date].MEMBERS,{LINKMEMBER([Due Date].[Date].CURRENTMEMBER,[Simulation Date].[Date])}),{[Measures].[Internal KPI Calendar Days]}),1),VALIDMEASURE([Measures].[Internal Detail Due Open Customer Orders EOD])),0),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Open Order Rate] AS IIF([Measures].[Due Order Count]&gt;0,[Measures].[Open Due Order Count]/[Measures].[Due Order Count],NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Full By End Rate] AS IIF([Measures].[Due Order Count]&gt;0,([Measures].[Due Order Count]-[Measures].[Lost Order Count]-[Measures].[Open Due Order Count])/[Measures].[Due Order Count],NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[All SKU Late Unit Days] AS IIF(VALIDMEASURE([Measures].[Internal Audit Run Count])=1 AND NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],SUM(EXISTING [Simulation Date].[Date].[Date].MEMBERS,[Measures].[Backlog Qty EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Late Unit Days] AS ([Measures].[All SKU Late Unit Days],[Product].[Manufactured].&amp;[1]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Average Daily Production Good Qty] AS IIF(VALIDMEASURE([Measures].[Internal Simulated Calendar Days])&gt;0,[Measures].[Production Good Qty]/VALIDMEASURE([Measures].[Internal Simulated Calendar Days]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Holding Cost] AS IIF(VALIDMEASURE([Measures].[Internal Audit Run Count])=1,[Measures].[Inventory Value Day Sum]*VALIDMEASURE([Measures].[Internal Holding Cost Annual Rate])/365.0,NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>