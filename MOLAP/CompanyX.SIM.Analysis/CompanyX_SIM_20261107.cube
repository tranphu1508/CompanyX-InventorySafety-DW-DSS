    <MdxScript ns1:design-time-name="61f27500-0e49-4392-b2b8-7d1961d232d4">
      <ID>Calculations</ID>
      <Name>Calculations</Name>
      <Commands><Command><Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[On Hand Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal On Hand Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
