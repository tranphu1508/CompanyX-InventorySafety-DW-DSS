  <MdxScripts>
    <MdxScript dwd:design-time-name="d4f86077-3fe6-44a5-9d6e-fb2e79f53abe">
      <ID>Calculations</ID>
      <Name>Calculations</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[On Hand Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal On Hand Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[WIP Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal WIP Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Inventory Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Inventory Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Owned In Transit Value EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Owned In Transit Value EOD]),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Line Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Line Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Completed Line Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Completed Line Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Due Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Due Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[On Time Full Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal On Time Full Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Lost Order Count] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Lost Order Count]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
CREATE MEMBER CURRENTCUBE.[Measures].[Simulated Calendar Days] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,([Measures].[Internal Simulated Calendar Days]),NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='RunDay', ASSOCIATED_MEASURE_GROUP='RunDay';
CREATE MEMBER CURRENTCUBE.[Measures].[On Hand Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw On Hand Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[WIP Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw WIP Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Queued Production Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Queued Production Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Open Purchase Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Open Purchase Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Backlog Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Backlog Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase In Transit Qty EOD] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase In Transit Qty EOD],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Due Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Due Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily On Time Delivered Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily On Time Delivered Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Late Delivered Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Late Delivered Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Lost Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Daily Lost Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[BOM Consumed Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw BOM Consumed Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase Accepted Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase Accepted Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Purchase Rejected Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Purchase Rejected Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Production Good Qty] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(NOT ISEMPTY([Measures].[Daily Unit Key Min]) AND [Measures].[Daily Unit Key Min]=[Measures].[Daily Unit Key Max],[Measures].[Raw Production Good Qty],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Average Inventory Value] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF(ISEMPTY([Measures].[Inventory Value Day Sum]) OR VALIDMEASURE(([Measures].[Internal Simulated Calendar Days]))&lt;=0,NULL,[Measures].[Inventory Value Day Sum]/VALIDMEASURE(([Measures].[Internal Simulated Calendar Days])))),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='SimulationDaily', ASSOCIATED_MEASURE_GROUP='SimulationDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Mean Completed Line Late Days] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Completed Line Count]&gt;0,[Measures].[Completion Late Days Sum]/[Measures].[Completed Line Count],NULL)),NULL), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='OrderLineService', ASSOCIATED_MEASURE_GROUP='OrderLineService';
CREATE MEMBER CURRENTCUBE.[Measures].[Whole Order OTIF] AS IIF(VALIDMEASURE(([Measures].[Internal Audit Run Count]))=1,(IIF([Measures].[Due Order Count]&gt;0,[Measures].[On Time Full Order Count]/[Measures].[Due Order Count],NULL)),NULL), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='OrderService', ASSOCIATED_MEASURE_GROUP='OrderService';
