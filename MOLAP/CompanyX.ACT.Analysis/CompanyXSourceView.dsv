  <ID>CompanyXSourceView</ID>
          <Name>CompanyX Source Views</Name>
          <DataSourceID>CompanyXSource</DataSourceID>
          <Schema>
            <xs:schema id="CompanyXSource">
              <xs:element name="CompanyXSource" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
                <xs:complexType>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="OpsDimChannel" msprop:DbTableName="DimChannel" msprop:DbSchemaName="cxoperations" msprop:FriendlyName="OpsDimChannel">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ChannelKey" type="xs:int" />
                          <xs:element name="ChannelName" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="40" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="OpsDimSalesStatus" msprop:DbTableName="DimSalesStatus" msprop:DbSchemaName="cxoperations" msprop:FriendlyName="OpsDimSalesStatus">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="SalesStatusKey" type="xs:int" />
                          <xs:element name="StatusName" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="40" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="DemandEligible" type="xs:int" minOccurs="0" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="OpsDimPurchaseStatus" msprop:DbTableName="DimPurchaseStatus" msprop:DbSchemaName="cxoperations" msprop:FriendlyName="OpsDimPurchaseStatus">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="PurchaseStatusKey" type="xs:int" />
                          <xs:element name="StatusName" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="40" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="OpsFactPurchases" msprop:DbTableName="FactPurchases" msprop:DbSchemaName="cxoperations" msprop:FriendlyName="OpsFactPurchases">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="PurchaseOrderLineKey" msdata:AutoIncrement="true" type="xs:long" />
                          <xs:element name="PurchaseOrderID" type="xs:int" />
                          <xs:element name="PurchaseOrderDetailID" type="xs:int" />
                          <xs:element name="OrderDateKey" type="xs:int" />
                          <xs:element name="ExpectedShipDateKey" type="xs:int" />
                          <xs:element name="ExpectedReceiptDateKey" type="xs:int" />
                          <xs:element name="VendorKey" type="xs:int" />
                          <xs:element name="ProductKey" type="xs:int" />
                          <xs:element name="PurchaseStatusKey" type="xs:int" />
                          <xs:element name="OrderQty" type="xs:int" minOccurs="0" />
                          <xs:element name="ReceivedQty" type="xs:decimal" minOccurs="0" />
                          <xs:element name="RejectedQty" type="xs:decimal" minOccurs="0" />
                          <xs:element name="StockedQty" type="xs:decimal" minOccurs="0" />
                          <xs:element name="LineTotal" type="xs:decimal" minOccurs="0" />
                          <xs:element name="DQCode" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="400" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="LineCount" type="xs:long" minOccurs="0" />
                          <xs:element name="DQLineCount" type="xs:long" minOccurs="0" />
                          <xs:element name="DeclaredVendorProductLineCount" type="xs:long" minOccurs="0" />
                          <xs:element name="LoadBatchID" type="xs:long" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="OpsFactInventory" msprop:DbTableName="FactInventory" msprop:DbSchemaName="cxoperations" msprop:FriendlyName="OpsFactInventory">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ProductKey" type="xs:int" />
                          <xs:element name="LocationKey" type="xs:int" />
                          <xs:element name="SnapshotDateKey" type="xs:int" />
                          <xs:element name="QuantityOnHand" type="xs:int" minOccurs="0" />
                          <xs:element name="InventoryValue" type="xs:decimal" minOccurs="0" />
                          <xs:element name="UnitCostAsOf" type="xs:decimal" minOccurs="0" />
                          <xs:element name="Shelf" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="10" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="Bin" type="xs:int" minOccurs="0" />
                          <xs:element name="ReportingDateRule" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="100" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="DQCode" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="400" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="PositionCount" type="xs:long" minOccurs="0" />
                          <xs:element name="NegativePositionCount" type="xs:long" minOccurs="0" />
                          <xs:element name="ZeroCostPositionCount" type="xs:long" minOccurs="0" />
                          <xs:element name="PositiveCostPositionCount" type="xs:long" minOccurs="0" />
                          <xs:element name="LoadBatchID" type="xs:long" />
                        </xs:sequence>
