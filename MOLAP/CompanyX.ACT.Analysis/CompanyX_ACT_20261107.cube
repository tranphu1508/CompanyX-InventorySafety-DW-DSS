  <Source dwd:design-time-name="73eef8c8-e32f-48b3-abfb-87ddcf17c5f1">
    <DataSourceViewID>CompanyXSourceView</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5a172f51-f5a0-47f2-b512-ce02271deea3">
      <ID>Calculations</ID>
      <Name>Calculations</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Sales Ordered Source Qty] AS ([Measures].[Raw Actual Sales Ordered Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Sales', ASSOCIATED_MEASURE_GROUP='ActualSales';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Sales Eligible Source Qty] AS ([Measures].[Raw Actual Sales Eligible Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Sales', ASSOCIATED_MEASURE_GROUP='ActualSales';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Purchase Ordered Source Qty] AS ([Measures].[Raw Actual Purchase Ordered Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Purchases', ASSOCIATED_MEASURE_GROUP='ActualPurchases';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Purchase Received Source Qty] AS ([Measures].[Raw Actual Purchase Received Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Purchases', ASSOCIATED_MEASURE_GROUP='ActualPurchases';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Purchase Rejected Source Qty] AS ([Measures].[Raw Actual Purchase Rejected Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Purchases', ASSOCIATED_MEASURE_GROUP='ActualPurchases';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Purchase Stocked Source Qty] AS ([Measures].[Raw Actual Purchase Stocked Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Purchases', ASSOCIATED_MEASURE_GROUP='ActualPurchases';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Inventory Source Qty] AS ([Measures].[Raw Actual Inventory Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Inventory', ASSOCIATED_MEASURE_GROUP='ActualInventory';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual WorkOrder Ordered Source Qty] AS ([Measures].[Raw Actual WorkOrder Ordered Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\WorkOrders', ASSOCIATED_MEASURE_GROUP='ActualWorkOrders';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual WorkOrder Stocked Source Qty] AS ([Measures].[Raw Actual WorkOrder Stocked Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\WorkOrders', ASSOCIATED_MEASURE_GROUP='ActualWorkOrders';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual WorkOrder Scrapped Source Qty] AS ([Measures].[Raw Actual WorkOrder Scrapped Source Qty]), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\WorkOrders', ASSOCIATED_MEASURE_GROUP='ActualWorkOrders';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Sales Recorded Ship By Due Line Rate] AS (IIF([Measures].[Actual Sales Ship Date Observed Lines]&gt;0,[Measures].[Actual Sales Recorded Ship By Due Lines]/[Measures].[Actual Sales Ship Date Observed Lines],NULL)), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='Operations\Sales', ASSOCIATED_MEASURE_GROUP='ActualSales';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual WorkOrder Mean Observed Lead Days] AS (IIF([Measures].[Actual WorkOrder Lead Observed Count]&gt;0,[Measures].[Actual WorkOrder Lead Days Sum]/[Measures].[Actual WorkOrder Lead Observed Count],NULL)), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\WorkOrders', ASSOCIATED_MEASURE_GROUP='ActualWorkOrders';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Operation Mean Observed Duration Days] AS (IIF([Measures].[Actual Operation Duration Observed Count]&gt;0,[Measures].[Actual Operation Duration Days Sum]/[Measures].[Actual Operation Duration Observed Count],NULL)), FORMAT_STRING='#,##0.00', VISIBLE=1, DISPLAY_FOLDER='Operations\Operations', ASSOCIATED_MEASURE_GROUP='ActualOperations';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Purchase Source Rejection Rate] AS (IIF([Measures].[Actual Purchase Received Source Qty]&gt;0,[Measures].[Actual Purchase Rejected Source Qty]/[Measures].[Actual Purchase Received Source Qty],NULL)), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='Operations\Purchases', ASSOCIATED_MEASURE_GROUP='ActualPurchases';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual WorkOrder Source Scrap Rate] AS (IIF([Measures].[Actual WorkOrder Ordered Source Qty]&gt;0,[Measures].[Actual WorkOrder Scrapped Source Qty]/[Measures].[Actual WorkOrder Ordered Source Qty],NULL)), FORMAT_STRING='0.00%', VISIBLE=1, DISPLAY_FOLDER='Operations\WorkOrders', ASSOCIATED_MEASURE_GROUP='ActualWorkOrders';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Demand Product Day Count] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Demand Product Day Count], NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Independent Demand Qty] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Independent Demand Qty], NULL), FORMAT_STRING='#,##0.####', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Dependent Demand Qty] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Dependent Demand Qty], NULL), FORMAT_STRING='#,##0.####', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Total Demand Qty] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Total Demand Qty], NULL), FORMAT_STRING='#,##0.####', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Demand Eligible Sales Line Count] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Demand Eligible Sales Line Count], NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Demand Excluded Sales Line Count] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Demand Excluded Sales Line Count], NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';
CREATE MEMBER CURRENTCUBE.[Measures].[Actual Demand Parent Work Order Count] AS IIF(COUNT(EXISTING [Demand Rule].[Demand Rule].[Demand Rule].MEMBERS)=1, [Measures].[Raw Actual Demand Parent Work Order Count], NULL), FORMAT_STRING='#,##0', VISIBLE=1, DISPLAY_FOLDER='Operations\Demand Daily', ASSOCIATED_MEASURE_GROUP='ActualDemandDaily';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>